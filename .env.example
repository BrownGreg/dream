# Copier en .env (jamais commité). Sans clé d'API, AI_MODE=fake fait tout fonctionner hors-ligne.

# --- Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Docker Compose : postgres://dream:dream@db:5432/dream ; hors Docker, laisser vide = SQLite
# Chiffrement des récits : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=
DATABASE_URL=
# smtp+tls://utilisateur:motdepasse@smtp.exemple.org:587 ; par défaut, e-mails affichés dans la console
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=

# --- IA (ADR-008, ADR-009). fake = adapters simulés, aucun appel ni coût.
AI_MODE=fake
AI_BUDGET_EUR=15
AI_BUDGET_ALERT_RATIO=0.8
# Taux prudent tant qu'aucun taux daté n'est renseigné (ADR-009)
AI_USD_EUR_RATE=1.0
AI_USER_DAILY_DREAMS=5
AI_MAX_IMAGE_ATTEMPTS=2
AI_MAX_ATTEMPTS=3
# Simulation : latence par appel (ms) et étapes en panne (ex. image,stt)
AI_FAKE_LATENCY_MS=0
AI_FAKE_FAIL_STEPS=

# --- Fournisseurs réels (AI_MODE=real)
MISTRAL_API_KEY=
MISTRAL_STT_MODEL=voxtral-mini-transcribe-3
MISTRAL_LLM_MODEL=mistral-small-2603
# Hugging Face Inference (émotion, 1er choix) ; un compte gratuit n'a pas de crédit inclus
HF_TOKEN=
HF_EMOTION_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
# Black Forest Labs, endpoint UE (ADR-004)
BFL_API_KEY=
BFL_IMAGE_MODEL=flux-2-klein-4b
